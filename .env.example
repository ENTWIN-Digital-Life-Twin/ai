AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8090
AI_LOG_LEVEL=INFO

SLEEP_MODEL_PATH=app/models/sleep_disorder_model.joblib
SLEEP_FEATURES_PATH=app/models/sleep_disorder_features.joblib
SLEEP_METADATA_PATH=app/models/sleep_disorder_model.metadata.json
LIFESTYLE_MODEL_PATH=app/models/lifestyle_risk_model.joblib
LIFESTYLE_METADATA_PATH=app/models/lifestyle_risk_model.metadata.json

SLEEP_MODEL_REQUIRED=true
LIFESTYLE_MODEL_REQUIRED=false

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.2
